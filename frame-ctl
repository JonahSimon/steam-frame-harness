    print("hs_virtual=%d" % sum(len(f) > 3 and f[1] in ("left", "right") and f[2] == "override" and "connected=1" in f[3]
                                for f in (l.split("\\t") for l in q("poses").splitlines())))
except OSError:
    pass
"""
HS_STATE_SH += shlex.quote(HS_DRIVER_PY)


def hs_state():
    """One ssh round trip: headset-side harness state as a dict ({} if the headset is unreachable)."""
    r = sh(f"ssh -o ConnectTimeout=5 -o BatchMode=yes {HOST} {shlex.quote(HS_STATE_SH)}", timeout=20)
    return dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)


def status():
    if driver_up():
        print(send("ping").strip())
        print("--- components (dev, path, type, real value, override)"); print(send("list").rstrip())
        print("--- poses"); print(send("poses").rstrip())
        al = [l.strip() for l in stats().splitlines() if "activity_level" in l]
        print("--- PC", al[0] if al else "vrcmd --stats: no activity_level")
    else:  # don't run vrcmd here: it can start SteamVR
        print("PC driver_framectl not answering (SteamVR not running?)")
