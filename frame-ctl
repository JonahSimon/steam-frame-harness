    print(f"--- Frame: worn flag " + (f"set {hs['worn_age_h']} h ago" if "worn_age_h" in hs else "off")
          + f" (/proximity override {hs.get('hs_prox', '?')}), agent-awake {hs.get('awake', '?')}, "
          f"dashguard {hs.get('dashguard', '?')}, dash-hide flag "
          + (f"set {hs['dash_hide_age_h']} h ago" if "dash_hide_age_h" in hs else "off")
