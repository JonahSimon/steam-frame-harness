#!/usr/bin/env python3
"""frame-ctl: drive the Steam Frame (HMD + controllers) for unattended VR game tests. See README.md.

  status                         driver, components, poses, activity level, Frame awake state
  spawn | despawn                virtual Frame controllers on/off (use when the real ones are asleep)
  press  <hand> <btn> [secs]     click+touch for secs (default 0.15) then release
  hold   <hand> <btn>            press and keep held       release <hand> <btn|all>
  trigger|grip <hand> <0..1>     analog value (>=0.9 also clicks); `off` releases
  stick  <hand> <x> <y> [secs]   thumbstick deflection (-1..1); `off` releases; secs = hold then release
  fingers <hand> <t> <i> <m> <r> <p> | off   finger curls 0..1 (default: derived from trigger, grip, touches)
  pose   <dev> <args...>         hmd|left|right: off | hold | x y z [qw qx qy qz] | head dx dy dz [q...]
  worn   on|off                  PC-side /proximity override + Frame agent-awake (prox fake)
  wake                           vrcmd --handlewakeup on PC and Frame
  dash   hide|allow|status       keep the Frame's Steam dashboard closed so the game has input focus
  shot   [out.png] [window]      screenshot: `vrview` (headset view, default) or a desktop window title
  focus  [window]                activate the game's desktop window (games ignore input unfocused)
  run    start <label> | stop | note <text>   per-run log folder (see README)
  vr-restart                     restart PC SteamVR (reloads driver_framectl), wait until the Frame streams, spawn
  launch <rungameid> [window]    Steam-launch a game, wait for its frames, then `dash hide`
  console <window> <cmd>         type a console command into a Bethesda VR game (Skyrim VR, Fallout 4 VR) window
  stream <appid>                 launch a PC game from the headset's Steam (flat games; skips PC-side prompts)
  hs <cmd> [args]                send spawn|despawn|clear|press|hold|release|trigger|grip|stick|raw|list to the
                                 driver inside the headset's SteamVR (frame/install-driver.sh). `hs spawn` gives
                                 vrlink controllers that drive flat games' Steam gamepad; PC-side `spawn` breaks it
  bindings [app-key]             what each Frame input does in the app's loaded SteamVR binding (default: latest app)
  watch                          live log of real headset button changes, injected input and game haptics
  cleanup [--keep-vr] [--keep-awake]  hand the setup back: stop run, quit games, clear overrides, despawn,
                                 let the headset dashboard work again, let the headset sleep, quit SteamVR
  busy   [gameid]                exit 0 + reason if the headset is in use (another Steam game running, or a
                                 vr-restart in progress); scripts call this before touching SteamVR
  doctor                         check tools, driver, SteamVR build, VR View, headset ssh, CEF tunnel, input focus
  raw    <driver command>        send a protocol line as-is
hand = left|right|all. btn = a b x y menu view system bumper trigger grip thumbstick thumbrest dpad_up/down/left/right.
"""
import glob, json, os, re, shlex, shutil, socket, subprocess, sys, time

# Config via env (see README).
os.environ.setdefault("DISPLAY", ":0")
PORT = 47823
HOST = os.environ.get("FRAMECTL_FRAME_HOST", "frame")            # ssh alias of the headset
AWAKE = os.environ.get("FRAMECTL_AWAKE_CMD", "~/bin/agent-awake")  # headset-side keep-awake toggle (see README)
GAME_WIN = os.environ.get("FRAMECTL_SHOT_WINDOW", "")              # game desktop window title for focus/shot
STATE = os.path.expanduser("~/.local/state/frame-ctl")
RUNPTR = os.path.join(STATE, "current-run")
SV = os.environ.get("STEAMVR", os.path.expanduser("~/.local/share/Steam/steamapps/common/SteamVR"))
VRCMD = f"{SV}/bin/linux64/vrcmd"
HERE = os.path.dirname(os.path.realpath(__file__))
ANALOG = {"trigger", "grip"}


# `frame-ctl hs <cmd>` targets the driver_framectl copy inside the headset's own SteamVR (frame/install-driver.sh).
# Controllers spawned there are relayed by vrlink like real ones, which is what PC Steam's flat-game gamepad reads;
# PC-spawned ones never feed it. Lines go through one ssh relay (UDP can't be ssh-forwarded).
HS = False
_relay = None
RELAY_PY = ("import socket,sys\ns=socket.socket(socket.AF_INET,socket.SOCK_DGRAM);s.settimeout(3)\n"
            "for l in sys.stdin:\n s.sendto(l.strip().encode(),('127.0.0.1',47823))\n"
            " try: r=s.recv(65535).decode()\n except OSError: r='err no reply from headset driver_framectl'\n"
            " sys.stdout.write(r.replace('\\n','\\x1f')+'\\n');sys.stdout.flush()\n")


def send_hs(line):
    global _relay
    if _relay is None:
        _relay = subprocess.Popen(["ssh", "-o", "ConnectTimeout=5", HOST, "python3 -u -c " + shlex.quote(RELAY_PY)],
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    _relay.stdin.write(line + "\n"); _relay.stdin.flush()
    r = _relay.stdout.readline()
    if not r:
        sys.exit(f"frame-ctl: ssh relay to {HOST} died (headset driver installed? frame/install-driver.sh)")
    r = r.rstrip("\n").replace("\x1f", "\n")
    timeline("hs " + line, r.splitlines()[0] if r else "")
    return r


def send(line, timeout=3):
    if HS:
        return send_hs(line)
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(timeout)
    s.sendto(line.encode(), ("127.0.0.1", PORT))
    try:
        r = s.recv(65535).decode()
    except socket.timeout:
        sys.exit("frame-ctl: no reply from driver_framectl on UDP 47823 (SteamVR not running or driver not loaded)")
    timeline(line, r.splitlines()[0] if r else "")
    return r


def me():
    """Who is calling: the agent session (Claude Code, Codex) or FRAMECTL_OWNER; "" for a person at a terminal."""
    for k in ("FRAMECTL_OWNER", "CLAUDE_CODE_SESSION_ID", "CODEX_SESSION_ID", "CODEX_THREAD_ID"):
        if os.environ.get(k):
            return os.environ[k]
    return ""


def foreign_run():
    """The active run if someone else owns it (live collector, owner differs from me()), else None (B10)."""
    d = run_dir()
    if not d:
        return None
    try:
        os.kill(int(open(os.path.join(d, ".collector.pid")).read()), 0)
    except (OSError, ValueError):
        return None  # stale pointer, collector gone
    try:
        owner = open(os.path.join(d, ".owner")).read().strip()
    except OSError:
        owner = ""
    return d if owner != me() else None


def guard(what):
    """Refuse a state-changing command while another agent's run is active: one headset, one driver, and their
    timeline would log our commands as theirs. Read-only commands (status, shot, bindings, doctor...) skip this."""
    d = foreign_run()
    if d and not os.environ.get("FRAMECTL_FORCE"):
        sys.exit(f"frame-ctl: {what}: headset in use by another agent's run {d}. Stop and ask; don't take it over. "
                 "(FRAMECTL_FORCE=1 overrides.)")


def run_dir():
    try:
        d = open(RUNPTR).read().strip()
        return d if os.path.isdir(d) else None
    except OSError:
        return None


def timeline(cmd, result):
    d = None if os.environ.get("FRAMECTL_NO_TIMELINE") else run_dir()
    if d:
        with open(os.path.join(d, "input-timeline.tsv"), "a") as f:
            f.write(f"{time.strftime('%F %T')}.{int(time.time() * 1000) % 1000:03d}\t{cmd}\t{result}\n")


def ok(r):
    print(r.strip())
    if r.startswith("err"):
        sys.exit(1)


def comps(btn):
    if btn in ANALOG:
        return [f"/input/{btn}/click", f"/input/{btn}/touch", f"/input/{btn}/value"]
    if btn == "thumbrest":
        return ["/input/thumbrest/touch"]
    return [f"/input/{btn}/click", f"/input/{btn}/touch"]


def setb(hand, btn, v):
    for c in comps(btn):
        ok(send(f"set {hand} {c} {v}"))


def rel(hand, btn):
    if btn == "all":
        return ok(send(f"rel {hand} all"))
    for c in comps(btn):
        ok(send(f"rel {hand} {c}"))


def sh(cmd, **kw):
    return subprocess.run(cmd, shell=True, text=True, capture_output=True, **kw)


DEPS = {"xdotool": "window focus", "spectacle": "screenshots (KDE)", "ssh": "headset access", "uv": "frame-cef"}


def need(*tools):
    missing = [t for t in tools if not shutil.which(t)]
    if missing:
        sys.exit("frame-ctl: missing " + ", ".join(f"{t} ({DEPS.get(t, '')})" for t in missing))


def window(name):
    r = sh(f"xdotool search --name '^{name}$' | head -1")
    return r.stdout.strip()


def focus(name=None):
    need("xdotool")
    name = name or GAME_WIN
    if not name:
        sys.exit("frame-ctl: which window? pass one or set FRAMECTL_SHOT_WINDOW to the game's desktop window title")
    w = window(name)
    if not w:
        sys.exit(f"frame-ctl: no window named {name}")
    for _ in range(5):  # KDE Wayland sometimes ignores the first activation
        sh(f"xdotool windowactivate --sync {w}")
        time.sleep(0.3)
        if sh("xdotool getactivewindow").stdout.strip() == w:
            timeline(f"focus {name}", "ok"); return
    sys.exit(f"frame-ctl: could not activate window {name}")


def shot(out=None, name=None):
    need("xdotool", "spectacle")
    name = name or GAME_WIN or "vrview"
    out = out or os.path.join(run_dir() or "/tmp", f"shot-{time.strftime('%H%M%S')}.png")
    prev = sh("xdotool getactivewindow").stdout.strip()
    if name == "vrview":
        w = window("VR View")
        if not w:
            sys.exit("frame-ctl: VR View window not open (steamvr.showMirrorView, see README)")
        sh(f"xdotool windowsize {w} 2400 1500")
        focus("VR View")
    else:
        focus(name)
    time.sleep(1)
    sh(f"spectacle -b -n -a -o '{out}'", timeout=30)
    if prev:  # games ignore controller input while their desktop window is unfocused, so hand focus back
        sh(f"xdotool windowactivate --sync {prev}")
    timeline(f"shot {name}", out)
    print(out)


def worn(on):
    # headset side first: it must work before SteamVR (and so the driver) is up, e.g. right before vr-restart
    r = sh(f"ssh -o ConnectTimeout=5 {HOST} '{AWAKE} {'on' if on else 'off'}'", timeout=120)
    print("headset agent-awake:", (r.stdout + r.stderr).strip()[-200:])
    if driver_up():
        ok(send("set hmd /proximity 1" if on else "rel hmd /proximity"))
    else:
        print("PC SteamVR not running: proximity override skipped (run `worn on` again after vr-restart if needed)")


def wake():
    sh(f"{VRCMD} --handlewakeup", timeout=15)
    r = sh(f"ssh -o ConnectTimeout=5 {HOST} '/opt/steamvr/bin/linuxarm64/vrcmd --handlewakeup'", timeout=20)
    timeline("wake", str(r.returncode))
    print("ok")


# The Frame's Steam client re-opens its dashboard ("ShowOverlay#1 valve.steam.gamepadui.main" over the websocket to
# its SteamVR) right after every hide while nobody uses it, and vrlink mirrors that to the PC, where the dashboard
# then owns all input (IsInputAvailable=0). `dash hide` drops that one message in the Frame's Steam JS and hides.
# The patch lives in the Frame's SharedJSContext, so a Steam restart on the Frame drops it; the headset's
# framectl-dashguard (frame/dashguard.py, keep its HOOK in sync) re-installs it while dash hide is in effect.
DASH_JS = """(()=>{if(!window.__fcDrop){window.__fcDrop=1;const o=WebSocket.prototype.send;WebSocket.prototype.send=function(d){
try{if(window.__noShowMain&&typeof d!="string"){const s=new TextDecoder("latin1").decode(d instanceof ArrayBuffer?new Uint8Array(d):d);
if(s.includes("ShowOverlay#1")&&s.includes("valve.steam.gamepadui.main")){(window.__fcDropped=window.__fcDropped||[]).push(Date.now());return}}}
catch(e){}return o.call(this,d)}};window.__noShowMain=%s;return "ok"})()"""


def cef(js, page=None):
    need("uv", "ssh")
    # argv list, not a shell string: multi-line JS must reach frame-cef byte for byte
    r = subprocess.run([f"{HERE}/frame-cef"] + ([page] if page else []) + [js], text=True, capture_output=True, timeout=30)
    if r.returncode:
        sys.exit("frame-ctl: frame-cef failed: " + (r.stderr or r.stdout).strip()[-300:])
    return r.stdout.strip()


def stream(appid):
    """Launch a PC game the way the headset's Library does (Steam game or non-Steam shortcut appid). A launch started
    on the PC while the Frame is linked waits on a prompt that shows nowhere; this one skips it."""
    host = socket.gethostname()
    devs = json.loads(json.loads(cef('new Promise(r=>{const h=SteamClient.RemotePlay.RegisterForDevicesChanges(d=>{'
                                     'r(JSON.stringify(d));try{h.unregister()}catch(e){}});setTimeout(()=>r("[]"),5000)})')))
    pc = next((d for d in devs if d["clientName"] == host), None) or next((d for d in devs if d.get("bCanStreamVR")), None)
    if not pc:
        sys.exit(f"frame-ctl: headset sees no streaming PC (devices: {[d['clientName'] for d in devs]})")
    cef(f'SteamClient.Apps.StreamGame({int(appid)},"{pc["clientId"]}",-1)')
    timeline(f"stream {appid}", pc["clientName"])
    print(f"streaming {appid} from {pc['clientName']}")


def dash(sub):
    if sub in ("hide", "allow"):
        # flag for the headset's framectl-dashguard, which re-installs the hook after a Steam restart there (B4)
        f = "~/.local/state/framectl/dash-hide"
        sh(f"ssh -o ConnectTimeout=5 {HOST} " + shlex.quote(f"mkdir -p ~/.local/state/framectl && touch {f}" if sub == "hide" else f"rm -f {f}"), timeout=20)
        cef(DASH_JS % ("true" if sub == "hide" else "false"), "SharedJSContext")
        want = "true" if sub == "hide" else "false"
        got = cef("String(window.__fcDrop === 1) + ',' + String(window.__noShowMain)", "SharedJSContext").strip('"')
        if got != f"true,{want}":  # confound guard: never report success unless the hook is really in place
            sys.exit(f"frame-ctl: dash {sub}: hook state on the headset is {got!r}, expected 'true,{want}'")
    if sub == "hide":
        cef("SteamClient.OpenVR.VROverlay.HideDashboard()")
        if not sh("pgrep -x vrserver").returncode:  # vrcmd would start SteamVR otherwise
            sh(f"{VRCMD} --hidedashboard", timeout=15)
        time.sleep(2)
    vis = cef("SteamClient.OpenVR.VROverlay.IsDashboardVisible()")
    timeline(f"dash {sub}", f"frame_dashboard_visible={vis}")
    print(f"frame dashboard visible: {vis}")


def driver_up():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.settimeout(1)
    try:
        s.sendto(b"ping", ("127.0.0.1", PORT)); return s.recv(100).startswith(b"ok")
    except OSError:
        return False


def stats():
    return sh(f"{VRCMD} --stats", timeout=15).stdout


VRSETTINGS = os.path.expanduser("~/.local/share/Steam/config/steamvr.vrsettings")


def set_mirror(on):
    """VR View (headset mirror window) on for tests, off for normal play. Only edits the file while SteamVR is
    stopped (vrserver rewrites it on exit); applies at the next SteamVR start."""
    if not sh("pgrep -x vrserver").returncode:
        return
    try:
        d = json.load(open(VRSETTINGS))
    except (OSError, ValueError):
        return
    blocked = d.get("driver_framectl", {}).get("blocked_by_safe_mode")
    if d.setdefault("steamvr", {}).get("showMirrorView") == on and not blocked:
        return
    if not os.path.exists(VRSETTINGS + ".bak-frame-ctl"):
        shutil.copy2(VRSETTINGS, VRSETTINGS + ".bak-frame-ctl")
    d["steamvr"]["showMirrorView"] = on
    if blocked:  # a vrserver crash makes SteamVR safe-mode-block every add-on driver, ours included
        print("driver_framectl was blocked by SteamVR safe mode; unblocking")
        d["driver_framectl"]["blocked_by_safe_mode"] = False
    json.dump(d, open(VRSETTINGS, "w"), indent=3)


MEM_WARN_GB = float(os.environ.get("FRAMECTL_MEM_WARN_GB", 8))


def mem_check(what):
    """Warn when RAM is short: a big modded VR game plus agents got an agent OOM-killed (blocker B9). zram swap
    still costs RAM, so MemAvailable is the number that matters."""
    try:
        gb = int(re.search(r"MemAvailable:\s+(\d+)", open("/proc/meminfo").read()).group(1)) / 1048576
    except (OSError, AttributeError):
        return
    if gb < MEM_WARN_GB:
        print(f"warning: only {gb:.1f} GB RAM available before {what} (want >= {MEM_WARN_GB:g}). A big modded game can "
              "get processes OOM-killed, agents included. Free RAM first (e.g. `vr-prep on`) and run no parallel agents.")
    timeline(f"mem {what}", f"{gb:.1f}GB")


CONSOLE_KEYS = {" ": "space", ".": "period", "_": "underscore", "-": "minus", '"': "quotedbl", ":": "colon",
                "/": "slash", ",": "comma", "'": "apostrophe", "=": "equal", "+": "plus"}


def console(win, command):
    """Bethesda VR console (B8). XTEST keys to the focused window one by one: `xdotool type` drops characters and
    `--window` (XSendEvent) is ignored. Lowercased: Shift+O toggles MGO's Open Animation Replacer, which eats keys."""
    need("xdotool")
    w = window(win)
    if not w:
        sys.exit(f"frame-ctl: no window titled {win!r}")
    focus(win)
    key = lambda k: (sh(f"xdotool key {k}"), time.sleep(0.15))
    key("grave"); time.sleep(2)  # the first open stalls the game ~1 s and eats keys
    for ch in command.lower():
        key(CONSOLE_KEYS.get(ch, ch))
    time.sleep(0.3); key("Return"); time.sleep(1)
    if not command.lower().startswith(("coc", "cow", "load", "qqq")):  # after these the console is already gone
        key("grave")
    timeline(f"console {win}", command)
    print(f"typed into {win}: {command.lower()}")


def check_roles(tries=3):
    """B6: the virtual controllers must hold the left/right roles. If one doesn't, re-send spawn (re-asserts the
    roles via the hide-real-controllers path) and check again."""
    p = os.path.join(HERE, "probe", "vrprobe")
    if not os.path.exists(p):
        return
    for i in range(tries):
        out = sh(p, timeout=20).stdout
        roles = {m.group(1) for m in re.finditer(r"class=2 role=(\d)", out)}
        if {"1", "2"} <= roles:
            return
        print(f"warning: controller roles {sorted(roles)} (want left=1 and right=2); re-asserting")
        timeline("roles", ",".join(sorted(roles)))
        ok(send("spawn")); time.sleep(2)
    print("warning: virtual controllers still lack a hand role; input to that hand may be ignored")


def vr_restart():
    refuse_if_busy()
    os.makedirs(STATE, exist_ok=True)
    open(LOCK, "w").write(f"{os.getpid()} {time.time()}")
    for n in ("vrserver", "vrmonitor"):
        sh(f"pkill -x {n}")
    for _ in range(60):
        if sh("pgrep -x vrserver").returncode: break
        time.sleep(1)
    set_mirror(True)
    sh("steam steam://run/250820 >/dev/null 2>&1 &")
    t, retried = time.time(), False
    while time.time() - t < 240:
        time.sleep(5)
        if driver_up() and '"activity_level" : 1' in stats(): break
        if not retried and time.time() - t > 30 and not driver_up() and "Using safe mode" in \
                open(os.path.join(os.path.dirname(VRSETTINGS), "../logs/vrserver.txt"), errors="replace").read():
            # SteamVR aborted on its last quit (vrlink watchdog), so it started in safe mode with our driver blocked
            print("SteamVR started in safe mode (its last quit crashed); unblocking driver_framectl, restarting once")
            retried = True
            for n in ("vrserver", "vrmonitor"):
                sh(f"pkill -x {n}")
            for _ in range(60):
                if sh("pgrep -x vrserver").returncode: break
                time.sleep(1)
            set_mirror(True)
            sh("steam steam://run/250820 >/dev/null 2>&1 &")
            t = time.time()
    else:
        sys.exit(f"frame-ctl: SteamVR/Frame stream not up after 240 s (headset awake? `ssh {HOST} {AWAKE} on`)")
    time.sleep(15)  # SteamVR must settle before a game launch
    ok(send("nodash on")); ok(send("spawn")); time.sleep(2); check_roles()
    try:
        dash("hide")
    except SystemExit as e:
        print(f"warning: dash hide failed ({e}); games may not get input until it works")
    timeline("vr-restart", "ok")
    os.remove(LOCK)


def spawned():
    return driver_up() and "left\t/input/a/click" in send("list")


def spawn():
    ok(send("spawn")); time.sleep(2); check_roles()
    running = sorted(set(steam_game_pids().values()))
    if running:  # games enumerate controllers at startup and ignore ones added later (seen with Skyrim VR)
        print(f"warning: game {', '.join(running)} was already running; it may ignore the virtual controllers "
              "until relaunched. Spawn before launching (frame-ctl launch does this).")


def launch(gameid, win=None):
    refuse_if_busy(gameid)
    mem_check(f"launch {gameid}")
    if driver_up() and not spawned():
        spawn(); time.sleep(2)
    win = win or GAME_WIN
    sh(f"steam steam://rungameid/{gameid} >/dev/null 2>&1 &")
    timeline(f"launch {gameid}", "")
    t = time.time()
    stage = False
    while time.time() - t < 300:
        time.sleep(5)
        if (not win or window(win)) and re.search(r'"average_application_gpu_time_ms" : [1-9]', stats()): break
        # Games like Half-Life: Alyx sit on a start stage ("Press Trigger to Start") set through a stage override and
        # submit no frames of their own until input, so frame stats alone would time out
        # (logged in the game's own vrclient_<exe>.txt; the pid is new each launch, so old lines can't match)
        pids = {str(p) for p, g in steam_game_pids().items() if g == str(gameid) or g.startswith(str(gameid))}
        logs = glob.glob(os.path.expanduser("~/.local/share/Steam/logs/vrclient_*.txt"))
        if pids and any(f"SetStageOverride_Async: pid {p} " in open(f, errors="replace").read() for f in logs for p in pids):
            stage = True; break
    else:
        sys.exit("frame-ctl: no game frames after 300 s")
    time.sleep(10)
    dash("hide")
    print("ok", round(time.time() - t), "s" + (" (game shows a start/loading stage and waits for input: look with "
                                                "`frame-ctl shot \"\" vrview`, it may say press the trigger)" if stage else ""))


def last_bindings():
    """{app_key: [binding files]} from vrserver.txt, in load order (one per controller type)."""
    out = {}
    for line in open(os.path.expanduser("~/.local/share/Steam/logs/vrserver.txt"), errors="replace"):
        m = re.search(r"Successfully loaded binding file '([^']+)' for app '([^']+)'", line)
        if m:
            files = out.setdefault(m.group(2), [])
            if m.group(1) in files: files.remove(m.group(1))
            files.append(m.group(1))
    return out


def bindings(app=None):
    b = last_bindings()
    skip = ("system.", "openvr.component", "steam.client", "vrlink.client")
    apps = [k for k in b if (app and app in k) or (not app and not k.startswith(skip))]
    if not apps:
        sys.exit("frame-ctl: no matching binding load in vrserver.txt. Apps seen: " + ", ".join(b))
    key = apps[-1]
    print(f"app {key}")
    for path in sorted(b[key], key=lambda f: "hmd" in f):  # controllers first
        print(f"\nfile {path}")
        try:
            d = json.load(open(path))
        except (OSError, ValueError) as e:
            print(f"  (can't read: {e})"); continue
        print("controller_type", d.get("controller_type", "?"))
        for aset, v in d.get("bindings", {}).items():
            rows = []
            for src in v.get("sources", []):
                for slot, o in src.get("inputs", {}).items():
                    rows.append(f"  {src['path']:<40} {src.get('mode', ''):<12} {slot:<10} -> {o.get('output', '')}")
            for k in ("poses", "haptics", "skeleton"):
                for o in v.get(k, []):
                    rows.append(f"  {o.get('path', ''):<40} {k:<12} {'':<10} -> {o.get('output', '')}")
            if rows:
                print(f"[{aset}]"); print("\n".join(sorted(rows)))


def watch():
    log = os.path.join(STATE, "driver.log")
    print(f"watching {log} (real = physical headset/controller input; Ctrl-C to stop)")
    os.execvp("sh", ["sh", "-c", f"tail -n0 -F '{log}' | grep --line-buffered -E ' (real|haptic|set|rel|pose|clear) '"])


def steam_game_pids():
    """{pid: SteamGameId} for every process Steam launched as a game (Proton or native), skipping SteamVR (250820)."""
    out = {}
    for d in glob.glob("/proc/[0-9]*"):
        try:
            env = open(d + "/environ", "rb").read().split(b"\0")
        except OSError:
            continue
        gid = next((e[12:].decode() for e in env if e.startswith(b"SteamGameId=")), None)
        if gid and gid not in ("0", "250820") and int(d[6:]) != os.getpid():
            out[int(d[6:])] = gid
    return out


LOCK = os.path.join(STATE, "vr-restart.lock")


def busy_reason(own=None):
    """Why the headset is in use by someone else, or None. `own` = the game id the caller is about to (re)launch."""
    try:
        pid = int(open(LOCK).read().split()[0])
        if pid != os.getpid() and os.path.exists(f"/proc/{pid}"):
            return f"vr-restart in progress (pid {pid})"
    except (OSError, ValueError, IndexError):
        pass
    if foreign_run():
        return f"another agent's run {foreign_run()} is active"
    others = sorted({g for g in steam_game_pids().values() if g != own and not (own and g.startswith(own))})
    return f"Steam game {', '.join(others)} is running" if others else None


def refuse_if_busy(own=None):
    r = busy_reason(own)
    if r and not os.environ.get("FRAMECTL_FORCE"):
        sys.exit(f"frame-ctl: headset busy: {r}. Another agent or person may be using it; stop and ask. "
                 "(FRAMECTL_FORCE=1 overrides.)")


def kill_games():
    pids = steam_game_pids()
    if not pids:
        print("games: none running"); return
    ids = sorted(set(pids.values()))
    for pid in pids:
        try: os.kill(pid, 15)
        except OSError: pass
    for _ in range(20):
        time.sleep(0.5)
        if not any(os.path.exists(f"/proc/{p}") for p in pids): break
    for pid in pids:
        try: os.kill(pid, 9)
        except OSError: pass
    timeline("cleanup kill games", ",".join(ids))
    print("games: stopped", ", ".join(ids), f"({len(pids)} processes)")


def cleanup(keep_vr=False, keep_awake=False):
    """Leave the PC and headset the way a human expects to find them."""
    steps = []
    def step(name, fn):
        try:
            fn(); steps.append(f"ok   {name}")
        except (SystemExit, Exception) as e:
            steps.append(f"FAIL {name}: {e}")
    if run_dir():
        step("stop run", lambda: run_cmd(["stop"]))
    step("quit games", kill_games)
    if driver_up():
        step("clear overrides", lambda: ok(send("clear")))
        step("despawn virtual controllers", lambda: ok(send("despawn")))
        step("driver nodash off", lambda: ok(send("nodash off")))
    def hs_reset():  # headset-side virtual controllers hide the real ones from the headset's Steam (flat-game pad)
        global HS
        HS = True
        try:
            r = send("ping")
            if r.startswith("err"): return print("headset driver not loaded")
            ok(send("clear")); ok(send("despawn"))
        finally:
            HS = False
    if sh(f"ssh -o ConnectTimeout=5 {HOST} 'test -d ~/framectl'", timeout=20).returncode == 0:
        step("headset driver: clear overrides, despawn", hs_reset)
    step("headset dashboard allowed", lambda: dash("allow"))
    if not keep_awake:
        step("headset may sleep (agent-awake off)",
             lambda: print(sh(f"ssh -o ConnectTimeout=5 {HOST} '{AWAKE} off'", timeout=120).stdout.strip()))
    if not keep_vr:
        def quit_vr():
            for n in ("vrmonitor", "vrserver"):
                sh(f"pkill -x {n}")
            for _ in range(30):
                if sh("pgrep -x vrserver").returncode: return
                time.sleep(1)
            raise RuntimeError("vrserver still running")
        step("quit SteamVR", quit_vr)
        step("VR View off for normal play", lambda: set_mirror(False))
    print("\n".join(["--- cleanup"] + steps))
    if any(x.startswith("FAIL") for x in steps):
        sys.exit(1)


def doctor():
    def chk(ok_, what, hint=""):
        print(("ok   " if ok_ else "FAIL ") + what + ("" if ok_ else f"  -> {hint}"))
        return ok_
    for t, why in DEPS.items():
        chk(shutil.which(t), f"{t} installed ({why})", "install it")
    chk(shutil.which("magick"), "magick installed (image checks in README examples)", "install imagemagick")
    chk(os.path.exists(VRCMD), f"SteamVR at {SV}", "set STEAMVR=<SteamVR dir>")
    up = chk(driver_up(), "driver_framectl answering on UDP 47823", "./build.sh install, then frame-ctl vr-restart")
    if up:
        lines = [l for l in open(os.path.join(STATE, "driver.log"), errors="replace") if "SteamVR build" in l]
        chk(lines and "enabled" in lines[-1], "dashboard hooks enabled for this SteamVR build",
            "unknown SteamVR build: dash hide still works, driver-side nodash/dash close are off")
        chk("left\t/input/a/click" in send("list"), "virtual controllers spawned", "frame-ctl spawn")
    chk(bool(window("VR View")), "VR View window open (headset capture)", "probe/vrprobe setbool steamvr showMirrorView 1, restart SteamVR")
    st = stats()
    chk('"activity_level" : 1' in st, "headset active (activity_level 1)", f"frame-ctl wake / worn on")
    r = sh(f"ssh -o ConnectTimeout=5 -o BatchMode=yes {HOST} 'test -x {AWAKE} && echo y'", timeout=20)
    chk(r.stdout.strip() == "y", f"ssh {HOST} works and {AWAKE} exists", "frame/install.sh")
    r = sh(f"{HERE}/frame-cef 'SteamClient.OpenVR.VROverlay.IsDashboardVisible()'", timeout=30)
    if chk(r.returncode == 0, "Steam CEF on the headset reachable over ssh tunnel", "SteamOS developer mode -> CEF remote debugging"):
        chk(r.stdout.strip() == "false", "headset dashboard closed", "frame-ctl dash hide")
    p = os.path.join(HERE, "probe", "vrprobe")
    if os.path.exists(p):
        o = sh(p, timeout=20).stdout.splitlines()
        chk(o and "input_available=1" in o[0], "PC SteamVR gives apps input (no dashboard capture)", "frame-ctl dash hide")


def status():
    print(send("ping").strip())
    print("--- components (dev, path, type, real value, override)"); print(send("list").rstrip())
    print("--- poses"); print(send("poses").rstrip())
    st = sh(f"{VRCMD} --stats", timeout=15).stdout
    al = [l.strip() for l in st.splitlines() if "activity_level" in l]
    print("--- PC", al[0] if al else "vrcmd --stats: no activity_level")
    r = sh(f"ssh -o ConnectTimeout=5 {HOST} '{AWAKE} status'", timeout=20)
    print("--- Frame agent-awake:", " ".join((r.stdout or r.stderr).split()))


def run_cmd(args):
    sub = args[0] if args else ""
    if sub == "start":
        cur = run_dir()
        if cur:  # one headset, one driver: two agents' runs would interleave inputs and logs
            try:
                os.kill(int(open(os.path.join(cur, ".collector.pid")).read()), 0)
                sys.exit(f"frame-ctl: run {cur} is active (another agent?). Stop it or wait; the headset is shared.")
            except (OSError, ValueError):
                pass  # stale pointer, collector gone
        label = "-".join(args[1:]) or "run"
        d = os.path.expanduser(f"~/frame-ctl-runs/{time.strftime('%Y%m%d-%H%M%S')}-{label}")
        os.makedirs(d)
        os.makedirs(STATE, exist_ok=True)
        open(os.path.join(d, ".owner"), "w").write(me())
        open(RUNPTR, "w").write(d)
        subprocess.Popen([os.path.join(HERE, "frame-ctl-logs"), "start", d], start_new_session=True,
                         stdout=open(os.path.join(d, "collector.log"), "a"), stderr=subprocess.STDOUT)
        timeline("run start", label)
        print(d)
    elif sub == "stop":
        d = run_dir()
        if not d:
            sys.exit("frame-ctl: no active run")
        timeline("run stop", "")
        subprocess.run([os.path.join(HERE, "frame-ctl-logs"), "stop", d])
        os.remove(RUNPTR)
        print(d)
    elif sub == "note":
        timeline("note", " ".join(args[1:]))
    else:
        sys.exit("usage: frame-ctl run start <label> | stop | note <text>")


def main(a):
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__); return
    c, r = a[0], a[1:]
    readonly = c in ("status", "shot", "bindings", "watch", "doctor", "busy") or (c == "run" and r[:1] == ["note"]) \
        or (c == "raw" and r[:1] in (["ping"], ["list"], ["poses"])) or (c == "hs" and r[:1] == ["list"]) \
        or (c == "dash" and r[:1] in ([], ["status"]))
    if not readonly and not (c == "run" and r[:1] == ["start"]):  # run start has its own check
        guard(" ".join(a[:2]))
    if c == "hs":
        global HS
        if not r or r[0] not in ("spawn", "despawn", "clear", "press", "hold", "release", "trigger", "grip", "stick",
                                 "raw", "list"):
            sys.exit("usage: frame-ctl hs spawn|despawn|clear|press|hold|release|trigger|grip|stick|raw|list ...")
        HS = True
        if r[0] == "spawn": return ok(send("spawn"))  # the PC-side spawn checks don't apply on the headset
        if r[0] == "list": return print(send("list").rstrip())
        c, r = r[0], r[1:]
    if c == "status": status()
    elif c == "spawn": spawn()
    elif c == "despawn":
        running = sorted(set(steam_game_pids().values()))
        if running and not os.environ.get("FRAMECTL_FORCE"):
            # controllers vanishing and coming back mid-game crashed Fallout 4 VR (Heisenberg mod, null read)
            sys.exit(f"frame-ctl: game {', '.join(running)} is running; despawning controllers under it can crash it. "
                     "Quit the game first (FRAMECTL_FORCE=1 overrides).")
        ok(send(c))
    elif c == "clear": ok(send(c))
    elif c == "press":
        setb(r[0], r[1], 1); time.sleep(float(r[2]) if len(r) > 2 else 0.15); rel(r[0], r[1])
    elif c == "hold": setb(r[0], r[1], 1)
    elif c == "release": rel(r[0], r[1])
    elif c in ANALOG:
        if r[1] == "off": rel(r[0], c)
        else:
            v = float(r[1])
            ok(send(f"set {r[0]} /input/{c}/value {v}"))
            ok(send(f"set {r[0]} /input/{c}/touch {1 if v > 0 else 0}"))
            ok(send(f"set {r[0]} /input/{c}/click {1 if v >= 0.9 else 0}"))
    elif c == "stick":
        if r[1] == "off":
            for k in ("x", "y", "touch"): ok(send(f"rel {r[0]} /input/thumbstick/{k}"))
        else:
            ok(send(f"set {r[0]} /input/thumbstick/touch 1"))
            ok(send(f"set {r[0]} /input/thumbstick/x {r[1]}")); ok(send(f"set {r[0]} /input/thumbstick/y {r[2]}"))
            if len(r) > 3:
                time.sleep(float(r[3]))
                for k in ("x", "y", "touch"): ok(send(f"rel {r[0]} /input/thumbstick/{k}"))
    elif c == "pose": ok(send("pose " + " ".join(r)))
    elif c == "fingers": ok(send("fingers " + " ".join(r)))
    elif c == "worn": worn(r[0] == "on")
    elif c == "wake": wake()
    elif c == "dash": dash(r[0] if r else "status")
    elif c == "vr-restart": vr_restart()
    elif c == "launch": launch(r[0], r[1] if len(r) > 1 else None)
    elif c == "stream": stream(r[0])
    elif c == "console": console(r[0], " ".join(r[1:]))
    elif c == "shot": shot(r[0] if r else None, r[1] if len(r) > 1 else None)
    elif c == "focus": focus(r[0] if r else None)
    elif c == "run": run_cmd(r)
    elif c == "bindings": bindings(r[0] if r else None)
    elif c == "watch": watch()
    elif c == "doctor": doctor()
    elif c == "busy":
        r = busy_reason(r[0] if r else None)
        print(r or "free"); sys.exit(0 if r else 1)
    elif c == "cleanup": cleanup("--keep-vr" in r, "--keep-awake" in r)
    elif c == "raw": print(send(" ".join(r)).rstrip())
    else: sys.exit(f"frame-ctl: unknown command {c}\n{__doc__}")


if __name__ == "__main__":
    main(sys.argv[1:])
