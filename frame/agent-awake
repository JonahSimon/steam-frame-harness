#!/bin/sh
# agent-awake on|off|status: make the Frame read as "worn" so it stays awake and games get focus unattended.
# on/off restart the headset's SteamVR (the stream drops for a few seconds, and games running on the headset die),
# so they do nothing when the state already matches.
case "$1" in
on)  systemctl is-active -q agent-noprox && { echo "on (unchanged)"; exit 0; }
     sudo systemctl enable --now agent-noprox; systemctl --user restart steamvr.service; echo on;;
off) systemctl is-active -q agent-noprox || { echo "off (unchanged)"; exit 0; }
     sudo systemctl disable --now agent-noprox; systemctl --user restart steamvr.service; echo off;;
*)   systemctl is-active agent-noprox; /opt/steamvr/bin/linuxarm64/vrcmd --stats 2>/dev/null | grep activity_level;;
esac
