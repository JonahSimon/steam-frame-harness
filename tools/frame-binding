#!/usr/bin/env python3
"""frame-binding <game-binding.json> [--out FILE] [--install ACTIONS_JSON] [--no-simulate]

Convert a game's SteamVR binding for another controller (usually Index "knuckles") into a native Steam Frame
binding, so the game stops falling back to SteamVR's automatic conversion. SteamVR picks Oculus Touch first for
Frame controllers (frame_controller_remapping.json priority 95), which loses per-finger input in games that have a
separate Touch hand mode (e.g. Boneworks: all fingers follow the grip).

- Button paths are remapped with SteamVR's own <from> -> frame_controller table (same as its auto-conversion).
- Index-only inputs get Frame equivalents: finger/index <- trigger pull, finger/middle|ring|pinky <- grip pull,
  grip force_sensor <- grip pull (trigger mode), grip grab <- grip click. Trackpad inputs are dropped (the Frame
  has none).
- The result tells the game it is on the source controller (`options.simulated_controller_type`), so the game keeps
  its hand logic and models for that controller.
- --install adds a frame_controller entry to the game's action manifest (backup: <file>.bak-frame-binding) and
  writes the binding next to it. A Steam "verify files" undoes it; rerun after game updates.
"""
import json, os, shutil, sys

SV = os.environ.get("STEAMVR", os.path.expanduser("~/.local/share/Steam/steamapps/common/SteamVR"))
FRAME = f"{SV}/drivers/frame_controller/resources/input"
FINGERS = {"index": "trigger", "middle": "grip", "ring": "grip", "pinky": "grip"}


def remap_table(src_type):
    lay = json.load(open(f"{FRAME}/frame_controller_remapping.json"))["layouts"]
    l = next((x for x in lay if x["from_controller_type"] == src_type), None)
    if not l:
        sys.exit(f"frame-binding: SteamVR has no {src_type} -> frame_controller remapping")
    table = {}
    for r in l.get("autoremappings", []):
        to = r["to"] if isinstance(r["to"], list) else [r["to"]]
        # SteamVR spreads the left upper face button over dpad left/right/up, right next to dpad down (the lower
        # one); a slightly sideways press then fires both (Boneworks: slow-mo also opens the menu). Keep up only.
        if len(to) > 1 and all("/input/dpad_" in t for t in to):
            to = [t for t in to if t.endswith("dpad_up")] or to
        table[r["from"]] = list(dict.fromkeys(to))
        if r.get("mirror", True):  # entries default to applying to the other hand too
            other = lambda p: p.replace("/right/", "/@/").replace("/left/", "/right/").replace("/@/", "/left/")
            table.setdefault(other(r["from"]), [other(t) for t in table[r["from"]]])
    return table, l


def convert(binding, src_type):
    profile = json.load(open(f"{FRAME}/frame_controller_profile.json"))["input_source"]
    inputs = set(profile)

    def fit(s, path):  # analog source routed to a plain button (e.g. trigger -> bumper): keep click/touch only
        comp = "/input/" + path.partition("/input/")[2]
        if profile.get(comp, {}).get("type") == "button" and s["mode"] != "button":
            ins = {k: v for k, v in s["inputs"].items() if k in ("click", "touch")}
            return {"path": path, "mode": "button", "inputs": ins} if ins else None
        return {**s, "path": path}
    table, layout = remap_table(src_type)
    notes, out = [], json.loads(json.dumps(binding))
    for aset, v in out.get("bindings", {}).items():
        new = []
        for s in v.get("sources", []):
            p = s["path"]
            hand, _, comp = p.partition("/input/")
            comp = "/input/" + comp
            if "/input/finger/" in p:
                src = FINGERS[comp.rsplit("/", 1)[1]]
                new.append({**s, "path": f"{hand}/input/{src}", "mode": "trigger"})
                notes.append(f"{aset}: {p} -> {hand}/input/{src} pull")
            elif comp == "/input/grip" and s["mode"] == "force_sensor":
                new.append({"path": p, "mode": "trigger",
                            "inputs": {"pull": i for k, i in s["inputs"].items() if k == "force"}})
                notes.append(f"{aset}: {p} force -> grip pull")
            elif s["mode"] == "grab":  # Index grab mode keys off the force sensor; the Frame grip only has a value
                new.append({"path": p, "mode": "trigger", "inputs": {"click": i for k, i in s["inputs"].items() if k == "grab"}})
                notes.append(f"{aset}: {p} grab -> grip click")
            elif p in table:
                for t in table[p]:
                    f = fit(s, t)
                    if f: new.append(f)
                if table[p] != [p]:
                    notes.append(f"{aset}: {p} -> {', '.join(table[p])}")
            elif comp in inputs:
                new.append(s)
            else:
                notes.append(f"{aset}: dropped {p} ({s['mode']}): no Frame equivalent")
        v["sources"] = new
        # Index bindings also list cross-hand skeletons (left hand driven by the right skeleton); invalid on the Frame
        if "skeleton" in v:
            v["skeleton"] = [k for k in v["skeleton"] if k["path"].split("/")[3] == k["path"].rsplit("/", 1)[1]]
    out["controller_type"] = "frame_controller"
    out["name"] = f"{binding.get('name', 'binding')} (Frame, converted from {src_type})"
    out["description"] = f"Generated by frame-binding from the game's {src_type} binding."
    if layout.get("simulate_controller_type", True):
        out["options"] = {"simulated_controller_type": src_type,
                          "simulate_rendermodel": bool(layout.get("simulate_render_model", True))}
    return out, notes


def main(a):
    if not a or a[0] in ("-h", "--help"):
        sys.exit(__doc__)
    src = a[0]
    binding = json.load(open(src))
    out, notes = convert(binding, binding["controller_type"])
    if "--no-simulate" in a:
        out.pop("options", None)
    dest = a[a.index("--out") + 1] if "--out" in a else None
    if "--install" in a:
        manifest = a[a.index("--install") + 1]
        dest = dest or os.path.join(os.path.dirname(manifest), "frame_controller_bindings.json")
        m = json.load(open(manifest))
        bak = manifest + ".bak-frame-binding"
        if not os.path.exists(bak):
            shutil.copy2(manifest, bak)
        m["default_bindings"] = [b for b in m.get("default_bindings", []) if b.get("controller_type") != "frame_controller"]
        m["default_bindings"].append({"controller_type": "frame_controller", "binding_url": os.path.basename(dest)})
        json.dump(m, open(manifest, "w"), indent=2)
        print(f"manifest: added frame_controller -> {os.path.basename(dest)} (backup {bak})")
    print("\n".join(notes))
    if dest:
        json.dump(out, open(dest, "w"), indent=2)
        print(f"wrote {dest}")
    else:
        print(json.dumps(out, indent=2))


if __name__ == "__main__":
    main(sys.argv[1:])
