#!/usr/bin/env python3
"""padwatch [secs] : log every gamepad evdev device that exists or appears (Steam Input's virtual pads included) and
every button/axis event from them, with timestamps. Shows whether controller input reaches the game layer on the PC,
independent of any game. Axis events are rate-limited to one line per axis per 0.2 s."""
import os, select, sys, time
import evdev
from evdev import ecodes as e

end = time.time() + float(sys.argv[1]) if len(sys.argv) > 1 else None
devs, last = {}, {}
ts = lambda: time.strftime("%H:%M:%S") + f".{int(time.time() * 1000) % 1000:03d}"

def is_pad(d):
    keys = d.capabilities().get(e.EV_KEY, [])
    return e.BTN_GAMEPAD in keys or e.BTN_SOUTH in keys or e.BTN_JOYSTICK in keys

def scan():
    for p in evdev.list_devices():
        if p in devs: continue
        try:
            d = evdev.InputDevice(p)
        except OSError:
            continue
        if is_pad(d):
            devs[p] = d
            print(f"{ts()} + {p} {d.name!r} vid={d.info.vendor:04x} pid={d.info.product:04x} phys={d.phys!r}", flush=True)
        else:
            d.close()

scan()
if not devs: print(f"{ts()} no gamepad devices", flush=True)
while end is None or time.time() < end:
    r, _, _ = select.select(list(devs.values()), [], [], 1.0)
    for d in r:
        try:
            evs = list(d.read())
        except OSError:
            print(f"{ts()} - {d.path} {d.name!r} gone", flush=True); del devs[d.path]; continue
        for ev in evs:
            if ev.type == e.EV_KEY:
                print(f"{ts()} {d.name}: {e.BTN.get(ev.code, e.KEY.get(ev.code, ev.code))} {'down' if ev.value else 'up'}", flush=True)
            elif ev.type == e.EV_ABS:
                k = (d.path, ev.code)
                if time.time() - last.get(k, 0) > 0.2:
                    last[k] = time.time()
                    print(f"{ts()} {d.name}: {e.ABS.get(ev.code, ev.code)}={ev.value}", flush=True)
    scan()
