#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = ["websocket-client"]
# ///
"""frame-cef [page-title-substring] <js>: evaluate JS in the Steam Frame's Steam CEF (default page SharedJSContext).

Reaches Steam's remote debug port (127.0.0.1:8080 on the headset, on when SteamOS developer mode has CEF remote
debugging enabled) through an ssh tunnel, so the port never has to be exposed on the LAN.
Env: FRAMECTL_FRAME_HOST (ssh alias, default "frame"); FRAMECTL_FRAME_CEF=host:port to skip the tunnel.
"""
import json, os, socket, subprocess, sys, time, urllib.request
import websocket

args = sys.argv[1:]
if not args or args[0] in ("-h", "--help"):
    sys.exit(__doc__)
match, js = (args[0], args[1]) if len(args) == 2 else ("SharedJSContext", args[0])

tunnel = None
host = os.environ.get("FRAMECTL_FRAME_CEF")
if not host:
    s = socket.socket(); s.bind(("127.0.0.1", 0)); port = s.getsockname()[1]; s.close()
    tunnel = subprocess.Popen(["ssh", "-N", "-o", "ExitOnForwardFailure=yes", "-o", "ConnectTimeout=5",
                               "-L", f"127.0.0.1:{port}:127.0.0.1:8080", os.environ.get("FRAMECTL_FRAME_HOST", "frame")])
    host = f"127.0.0.1:{port}"
    for _ in range(50):
        try:
            socket.create_connection(("127.0.0.1", port), 0.2).close(); break
        except OSError:
            if tunnel.poll() is not None: sys.exit("frame-cef: ssh tunnel failed")
            time.sleep(0.2)
try:
    pages = json.load(urllib.request.urlopen(f"http://{host}/json", timeout=10))
    page = next((p for p in pages if match in p["title"]), None)
    if not page:
        sys.exit(f"frame-cef: no CEF page titled *{match}* (is Steam running on the headset with CEF debugging on?)")
    ws = websocket.create_connection(page["webSocketDebuggerUrl"].replace("localhost:8080", host).replace("127.0.0.1:8080", host),
                                     suppress_origin=True, timeout=20)
    ws.send(json.dumps({"id": 1, "method": "Runtime.evaluate",
                        "params": {"expression": js, "awaitPromise": True, "returnByValue": True}}))
    while True:
        r = json.loads(ws.recv())
        if r.get("id") == 1: break
    res = r.get("result", {})
    print(json.dumps(res.get("result", {}).get("value", res), indent=1)[:20000])
finally:
    if tunnel: tunnel.terminate()
